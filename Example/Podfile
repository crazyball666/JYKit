use_frameworks!

# 注意：示例工程使用较新的 Xcode 模拟器运行时（最低支持 iOS 15），
# 因此 demo 的部署版本高于 JYKit.podspec 声明的 iOS 13（SDK 本身仍支持 13）。
platform :ios, '15.0'

target 'JYKit_Example' do
  pod 'JYKit', :path => '../'
end

post_install do |installer|
  # 当前 Xcode 的 SDK 只支持 iOS 15 及以上的部署版本，
  # 统一抬高 Pods 目标，保证示例工程和 CI 二进制产物都能构建。
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
