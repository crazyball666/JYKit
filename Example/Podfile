use_frameworks!

# 注意：示例工程使用较新的 Xcode 模拟器运行时（最低支持 iOS 15），
# 因此 demo 的部署版本高于 JYKit.podspec 声明的 iOS 13（SDK 本身仍支持 13）。
platform :ios, '15.0'

target 'JYKit_Example' do
  pod 'JYKit', :path => '../'
end

post_install do |installer|
  # 新版 Xcode 的模拟器运行时不再支持 < 15 的部署版本，
  # 本地把 Pods 目标抬到 15 以保证 demo 能跑起来。
  # CI 构建二进制产物时需要保持 podspec 声明的最低版本（13.0），因此跳过。
  next if ENV['CI']

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
